# ============================================================
# AZ MONOPRIX — .gitignore
# ============================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/
next-env.d.ts

# Production builds
/build

# TypeScript incremental
*.tsbuildinfo

# Env files — never commit real secrets
.env
.env.local
.env.*.local
.env.production
!.env.local.example

# Supabase local runtime
/supabase/.temp
/supabase/.branches

# OS
.DS_Store
Thumbs.db
*.pem
*.bak
*.swp

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel
.vercel

# IDE
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Claude / Cursor tooling (personnel)
.cursor/

# Cloud env (Supabase Cloud credentials — NEVER commit)
.env.cloud
.env.cloud.*
