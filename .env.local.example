# ============================================================
# AZ MONOPRIX — Environment Variables (Development)
# Copy to .env.local and fill in values.
# NEVER commit .env.local.
# ============================================================

# --- Supabase (local dev via `pnpm db:start`) ---------------
# These defaults match `supabase start` output on localhost.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_local_anon_key
# Server-only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace_with_local_service_role_key

# --- App --------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="AZ Monoprix"
NEXT_PUBLIC_DEFAULT_LOCALE=fr
NEXT_PUBLIC_DEFAULT_CURRENCY=DZD

# --- Maps (choose one) -----------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# --- Notifications ---------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- AI (server only) -------------------------------------------
AI_PROVIDER=gemini             # gemini | anthropic | openai
GEMINI_API_KEY=                # https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gemini-2.0-flash

# --- Feature flags ---------------------------------------------
FEATURE_AI_SHOPPING=true
FEATURE_AI_ADMIN=true
FEATURE_LIVE_TRACKING=true
